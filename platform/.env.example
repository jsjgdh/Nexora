# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=production

# Public edge
GATEWAY_PORT=8080
# Browser origin of the frontend (must match exactly for CORS).
FRONTEND_URL=http://localhost:3000
# Reverse-proxy hops to trust in front of the gateway, for the client IP that
# rate limits key on. X-Forwarded-For is written by the caller, so this decides
# whether they can choose their own rate-limit bucket. Leave at 0 when the
# gateway is the public surface (the socket address is the client). Set to 1
# when a TLS reverse proxy you own fronts it - and only then. A literal "true"
# is rejected on purpose.
TRUST_PROXY=0

# Internal service mesh (compose hostnames work out of the box)
AUTH_URL=http://auth:8101
CURRICULUM_URL=http://curriculum:8102
EXECUTION_URL=http://execution:8104
BILLING_URL=http://billing:8106

# Shared secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
#
# The two values below are placeholders and are REFUSED at boot: the gateway and
# the auth service reject a placeholder secret in every environment, so a
# deployment that merely copied this file fails loudly with a message naming the
# variable, instead of coming up with a secret that is published in git. Replace
# both with generated values before starting anything.
AUTH_JWT_SECRET=change-me-to-32-plus-random-characters
# Two jobs: it authenticates service-to-service calls, and a purpose-derived key
# from it signs the run receipts the platform re-judges for IDE attestation.
# Required at boot in EVERY environment (B-27): a service or gateway with no
# real key here refuses to start, because without one every internal route
# trusts a bare x-user-id header from any caller. The only way to run without it
# is the explicit development opt-in below, and a run with no key carries no
# receipt signature. Set it before serving paid phases to anyone.
INTERNAL_API_KEY=change-me-internal-mesh-key

# Development only, never a production flag: run the mesh without a key, and
# therefore with no proof of identity on any internal route. Refused outright
# when NODE_ENV=production. Leave it commented unless you are running services
# locally and have no INTERNAL_API_KEY to hand.
# ALLOW_INSECURE_MESH=1

# Offline receipt verification (B-24): the operator-held Ed25519 receipt key.
# Its public half is published at GET /api/execute/verify-key so a stranger
# re-derives a verdict without asking the platform — and without learning
# anything that mints. Unlike INTERNAL_API_KEY it is never derived and never
# shared between services: it lives in the execution service's environment
# only. Absent, receipts carry the HMAC alone and offline verification is
# unavailable (the key endpoint 503s) rather than faked.
# Generate once and keep it secret:
#   node -e "console.log(require('node:crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
# (single line; newlines as \n inside .env)
# RECEIPT_ED25519_KEY=
# Names the published key so rotation does not orphan old receipts.
# RECEIPT_KEY_ID=ed1
#
# The PUBLIC half of the same key, for the auth service, which VERIFIES receipts
# when they are synced and never mints one. Holding the public half only is the
# point: the service that stores evidence cannot write evidence. The value is
# not secret — it is published at /api/execute/verify-key — but it is configured
# here so the two halves are versioned from one place and a rotation is one
# write rather than two.
# RECEIPT_ED25519_PUBLIC_KEY=

# Authentication mode: "local" (built-in JWT service, zero config) or
# "clerk" (Clerk session tokens verified via JWKS from the secret key, or a
# pinned PEM). In clerk mode /auth mounts Clerk's components and the mesh
# links each Clerk subject to a profile row on first sight (POST /auth/link).
AUTH_MODE=local
# Clerk production mode needs exactly one of these:
CLERK_SECRET_KEY=
# ...or a pinned PEM public key (safe to store; newlines as \n):
CLERK_JWT_KEY=
# Comma-separated allowed frontend origins (defaults to FRONTEND_URL).
CLERK_AUTHORIZED_PARTIES=

# Transactional mail (Resend). The auth service sends the password-reset and
# email-verification links; the site sends its own acknowledgements from the
# same provider.
#
# Without a key, or without a from address, NO mail is sent: the request is
# still answered, the token is still stored, and a structured line is logged
# saying the mail was skipped and why. A deployment without a provider must
# not turn a password reset into an error. Outside production the token is
# also written to the log at debug level, so a developer can finish the flow
# with no provider at all. A live token is never written to a log in
# production.
RESEND_API_KEY=
# The from address, with a name if you want one: "NEXORA <hello@nexora.dev>".
# The domain has to be verified in the Resend dashboard before any mail is
# sent from it.
RESEND_FROM=NEXORA <hello@nexora.dev>
# The origin the site is served from, used to build the links the mail
# carries. The same variable name the site uses (PUBLIC_SITE_URL), so one
# value configures both halves: the site that renders the page and the
# service that builds the link into it. Without it the auth service cannot
# build a link and skips the mail, rather than sending a token to a host
# that is not the product.
PUBLIC_SITE_URL=http://localhost:5173

# The site routes the reset and verification mails point at. Paths, not URLs:
# the origin of a mail that carries a live token is always PUBLIC_SITE_URL, so
# a value that is not a path is ignored and the default stands. They exist so
# the site and this service cannot drift apart when a page is renamed.
# PASSWORD_RESET_PATH=/auth/password-reset/confirm
# VERIFY_EMAIL_PATH=/auth/verify-email/confirm

# Access-token lifetime, in seconds. Clamped to 60..900.
#
# This window is the whole revocation story for access tokens: they are stateless
# (the gateway verifies them without asking anyone), so nothing can invalidate one
# early. Signing out revokes the refresh family at once, which stops new tokens
# being minted, and the token already in a browser dies here. 300 keeps a stolen
# copy useful for minutes rather than a quarter of an hour. The app renews in the
# background through an HttpOnly cookie, so a shorter life is invisible to a
# learner — do not lengthen it to "fix" a session that ends early; fix the renewal.
ACCESS_TOKEN_TTL_SECONDS=300

# Immediate revocation. The gateway asks the auth service whether the `jti` a token
# carries has been revoked before it trusts it, which is what makes a sign-out (and
# "sign out everywhere") take effect on the next request instead of at the end of the
# token's life.
#
# How long to wait for that answer before treating it as unavailable, in ms.
REVOCATION_TIMEOUT_MS=2000
# How long a CONFIRMED CLEAR answer may still be acted on when the auth service
# cannot be reached, in ms - the graceful-degradation bound.
#
# Without it, a check in front of every authenticated request means an auth-service
# restart is a product outage: every request fails 503. With it, a credential whose
# check was confirmed clear inside this window keeps working, and the edge logs an
# error and counts each such request as `degraded`.
#
# What it costs, stated plainly: a sign-out during the outage can be missed for up to
# this long, for credentials already confirmed just before it. The window runs from
# the last confirmation, not from the start of the outage, so a long outage converges
# back to 503 by itself, and a credential nobody confirmed inside the window is still
# refused. 0 disables the fallback entirely. Clamped to 0..300000 - do not raise it to
# paper over a flaky auth service; fix the service.
REVOCATION_CLEAR_TTL_MS=60000
# How often the edge reports revocation counters (refused / unanswered / degraded),
# in ms. Either way, the first refusal, unanswered check or degraded allow after a
# quiet period is logged immediately, at warn/error respectively.
#
# The same counters, plus the current degradation state, are readable from the
# gateway's /health/deep (revocations.authService / .degraded / .outageMs), so a
# monitor with no log access can alert on the auth service going away: status goes
# "degraded" while it is unreachable. Reading it performs no check of its own.
REVOCATION_REPORT_MS=60000

# Databases (one Postgres host, one database per service)
AUTH_DATABASE_URL=postgres://nexora:nexora@postgres:5432/authdb
BILLING_DATABASE_URL=postgres://nexora:nexora@postgres:5432/billingdb
POSTGRES_PASSWORD=nexora

# Execution sandbox
# subprocess = single-tenant / trusted host (the toolchain lives in this image).
#              It is NOT an isolation boundary: learner code runs as a child of
#              the execution service with the same filesystem, network and
#              process namespace, so it can read INTERNAL_API_KEY and
#              DATABASE_URL (e.g. /proc/1/environ) — and INTERNAL_API_KEY also
#              seeds the run-receipt signing key. A production boot therefore
#              REFUSES this tier (the service exits, naming EXECUTION_RUNNER)
#              unless you accept the risk explicitly below.
# docker     = multi-tenant (each job gets its own container; needs a daemon and
#              the runner images). For Go, build the image first:
#                docker build -t nexora-go-runner:1 images/go-runner
EXECUTION_RUNNER=subprocess
# Only for a single-tenant host you control and understand. With this unset (or
# 0), production fails closed rather than run learner code beside its own
# credentials.
EXECUTION_ALLOW_SUBPROCESS=0
EXECUTION_CONCURRENCY=2
EXECUTION_DAILY_QUOTA=200
EXECUTION_DEFAULT_TIMEOUT_MS=8000

# Go build cache. Set to a persistent path to pay the cost of compiling the
# standard library once instead of on every learner's first program. Cache keys
# are content-addressed, so sharing it across learners is a deliberate,
# documented tradeoff; leaving it unset gives each job a private cache (safer,
# slower, always correct). Compose sets /opt/gocache, which the image prewarms.
# EXECUTION_GO_CACHE=/opt/gocache

# Dodo Payments billing (optional; without these, checkout/webhooks 503
# with a clear message while plans/subscription reads still work)
# Base: https://test.dodopayments.com (test) or https://live.dodopayments.com
DODO_PAYMENTS_BASE=https://test.dodopayments.com
DODO_PAYMENTS_API_KEY=
# The endpoint signing secret from Developer → Webhooks (Dodo's SDKs read the
# same value as DODO_PAYMENTS_WEBHOOK_KEY — ours is named _SECRET because it
# is one, and is never a publishable key). Must start with whsec_; the HMAC
# key is the base64-decoded remainder per Standard Webhooks.
DODO_PAYMENTS_WEBHOOK_SECRET=
# plan slug -> { product_id (from Dodo dashboard), name }
# DUMMY / PLACEHOLDER - NOT LIVE. These product_id values are fake, present so the
# config SHAPE is real and testable; they cannot be checked out against Dodo and
# must never be published to customers. Go-live is blocked until the owner replaces
# each pdt_...PLACEHOLDER with the real product_id from the Dodo dashboard (test or
# live), one tier. Recorded in company DECISIONS D-012 and the paywall programme
# (see BACKLOG).
#
# THE PRICE, in one place: the front door prints $29 a month and $290 a year
# (nexora-svelte/src/lib/content/site.ts, PRICING). The provider's dashboard
# must be configured to those same numbers before checkout is switched on,
# because a checkout that charges a different number than the front door
# printed is exactly the failure this file exists to prevent. Do not switch
# checkout on until the two agree.
#
# Teams ($29 per learner per month, billed yearly, five learners or more) is
# invoiced and is deliberately NOT in this file: it is not a checkout, so it
# has no provider product, and inventing one would put a plan in the
# provider that nobody can buy.
BILLING_PLANS_JSON={"pro-monthly":{"product_id":"pdt_29_monthly_PLACEHOLDER","name":"NEXORA Pro (monthly)"},"pro-annual":{"product_id":"pdt_290_annual_PLACEHOLDER","name":"NEXORA Pro (annual)"}}
