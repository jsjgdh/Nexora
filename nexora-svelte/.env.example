[TEMPLATE]
# Learner app configuration. Copy to `.env` only if you want cloud mode.
#
# IMPORTANT: with nothing set, the app runs in LOCAL MODE — progress, drafts and
# evidence live in the browser and every mission that can be assessed offline
# still works. Local mode is the product's default resilience, not an error
# state, and the UI says so plainly on /auth.
#
# PUBLIC_* variables are baked into the client at build time, because they must
# be readable by the browser. Never put a secret here.

# Base URL of the platform gateway, as seen FROM THE BROWSER.
# Leave empty for local mode. For the compose stack that is:
PUBLIC_API_URL=http://127.0.0.1:8080

# Clerk publishable key (pk_test_* / pk_live_*). Set this to offer Clerk
# sign-in on /auth; without it the page keeps the local email/password forms
# (or the not-connected story when PUBLIC_API_URL is also empty). Public, so
# it is safe to bake into the client — but it must be the publishable key,
# never a secret key.
# PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Set this only if you want the *dev server* to talk to a gateway running on a
# different origin than the browser uses (rare). Most setups should not need it.
# PUBLIC_API_URL_INTERNAL=http://localhost:8080

# The origin this deployment is served from. Every generated URL is built from
# it — /sitemap.xml, /robots.txt, each page's <link rel="canonical"> and the URL
# on its social card — so it is the one value a public deployment must set.
# Leave it empty and all of them fall back to http://localhost:5173, which is
# correct for local mode and wrong for anything public.
#
# Set it wherever the BUILD runs, not only where the server runs: /sitemap.xml,
# /robots.txt and the 27 mission pages are prerendered, so they bake the value
# that was present at build time. Pages rendered at runtime read it live.
# PUBLIC_SITE_URL=https://nexora.example
