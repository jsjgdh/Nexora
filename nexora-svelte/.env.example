[TEMPLATE]
# Learner app configuration. Copy to `.env` only if you want cloud mode.
#
# IMPORTANT: with nothing set, the app runs in LOCAL MODE — progress, drafts and
# evidence live in the browser and every mission that can be assessed offline
# still works. Local mode is the product's default resilience, not an error
# state, and the UI says so plainly on /auth.
#
# PUBLIC_* variables are baked into the client at build time, because they must
# be readable by the browser. Never put a secret here.

# Base URL of the platform gateway, as seen FROM THE BROWSER.
# Leave empty for local mode. For the compose stack that is:
PUBLIC_API_URL=http://127.0.0.1:8080

# Clerk publishable key (pk_test_* / pk_live_*). Set this to offer Clerk
# sign-in on /auth; without it the page keeps the local email/password forms
# (or the not-connected story when PUBLIC_API_URL is also empty). Public, so
# it is safe to bake into the client — but it must be the publishable key,
# never a secret key.
# PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Where THIS SERVER (not the browser) reaches the gateway. Server-side, so it is
# never visible to the client — and it exists because the two addresses differ in
# any containerised deployment: the browser reaches the gateway on the published
# 127.0.0.1:8080, while the app's own server reaches it at http://gateway:8080 on
# the compose network. It is read by /auth/session/* — the endpoints that keep the
# refresh token in an HttpOnly cookie instead of the page — so a wrong value here
# looks like sign-in failing with "the sign-in service did not answer" while
# everything else works.
# Leave it unset to fall back to PUBLIC_API_URL, which is right for `vite dev`
# (both are localhost) and wrong for compose.
# GATEWAY_URL=http://gateway:8080

# The origin this deployment is served from. Every generated URL is built from
# it — /sitemap.xml, /robots.txt, each page's <link rel="canonical"> and the URL
# on its social card — so it is the one value a public deployment must set.
# Leave it empty and all of them fall back to http://localhost:5173, which is
# correct for local mode and wrong for anything public.
#
# Set it wherever the BUILD runs, not only where the server runs: /sitemap.xml,
# /robots.txt and the 27 mission pages are prerendered, so they bake the value
# that was present at build time. Pages rendered at runtime read it live.
# PUBLIC_SITE_URL=https://nexora.example

# Where the desktop IDE build can be downloaded, as seen FROM THE BROWSER. This
# is the one switch behind /download: set it to a hosted installer and the page
# links to it; leave it unset (the default) and the page says the desktop build is
# not published yet and points the learner to the browser curriculum instead of
# rendering a dead link. Public, so it must be a URL, never a secret.
# PUBLIC_IDE_DOWNLOAD_URL=

# --- AI tutor (optional) ---
# The authenticated path is the platform's own tutor endpoint
# (/api/tutor/ask, behind the gateway) and that is what a cloud deployment
# should use. The app ALSO ships a server-side proxy at /api/tutor so a build
# with no account can still explain a compiler error offline — but that route
# spends the operator's AI quota and anyone who can load the page can call it,
# so it stays off unless you turn it on deliberately. These are server-side
# (never PUBLIC_), so they are read from the server environment at runtime.
# NEXORA_AI_ALLOW_APP_ROUTE=1
# NEXORA_AI_URL=https://api.example.com/v1/chat/completions
# NEXORA_AI_KEY=
# NEXORA_AI_MODEL=default
