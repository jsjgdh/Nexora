{
  "name": "nexora-svelte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "start": "node build",
    "verify": "tsx scripts/verify.ts && tsx scripts/verify-account.ts && tsx scripts/verify-admin.ts && tsx scripts/verify-observability.ts",
    "verify:account": "tsx scripts/verify-account.ts",
    "verify:admin": "tsx scripts/verify-admin.ts",
    "verify:a11y": "tsx scripts/verify-a11y.ts",
    "verify:csp": "tsx scripts/verify-csp.ts",
    "verify:platform": "tsx scripts/verify-platform.mjs",
    "verify:ux": "tsx scripts/verify-ux.ts",
    "sync:copy": "node scripts/sync-curriculum-copy.mjs",
    "shoot": "tsx scripts/shoot.ts"
  },
  "dependencies": {
    "@kinde-oss/kinde-auth-sveltekit": "^2.5.0",
    "@sveltejs/kit": "^2.0.0",
    "resend": "^6.34.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^2.0.0",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.64.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
