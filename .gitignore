node_modules/
.next/
.svelte-kit/
build/
out/
*.log
.DS_Store
.env
.env.local

# The local stack's databases (PGlite data directories) and its scratch files.
platform/.local/

# Compiled output. Both images build from source (see nexora-svelte/Dockerfile
# and platform/Dockerfile), so nothing generated belongs in history.
dist/
*.tsbuildinfo

# tsc emit that leaked next to sources instead of into dist/.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Reference checkouts. These are other people's repositories, cloned to read
# their ideas; they are not part of this product and they bring their own
# history with them.
.agents/*/
